<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#FBFBFB"
    tools:context=".profilefrag">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Profile"
        android:textSize="45sp"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="20dp"
        android:textColor="#070606"
        android:layout_marginTop="70dp"
        android:textStyle="bold"/>
    <androidx.cardview.widget.CardView
        android:layout_width="410dp"
        android:layout_height="200dp"
        app:cardCornerRadius="30dp"
        android:layout_marginLeft="10dp"
        app:cardBackgroundColor="#FBFBFB"
        app:cardElevation="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="180dp"
                android:layout_height="175dp"
                android:layout_marginLeft="20dp"
                android:id="@+id/imagg"
                android:layout_gravity="center"
                android:src="@drawable/goodboy"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:id="@+id/tvName"
                android:textColor="#123"
                android:text="mani"
                android:textSize="40dp"
                android:layout_marginTop="40dp"
                android:layout_marginLeft="20dp"
                android:textStyle="bold"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_marginLeft="20dp"
                android:textSize="25dp"
                android:layout_marginTop="10dp"
                android:id="@+id/badgeText"
                android:textColor="#123"
                android:text="Beginner"/>


            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Statistics"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="15dp"
        android:textSize="20dp"
        android:textColor="#123"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">
        <androidx.cardview.widget.CardView
            android:layout_width="190dp"
            android:layout_height="100dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#FF6B6B"
            android:layout_marginLeft="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="workouts completed"
                    android:textSize="15sp"
                    android:textColor="#FCD5D9"
                    android:layout_marginTop="12dp"
                    android:layout_marginLeft="15dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvCompleted"
                    android:textStyle="bold"
                    android:textColor="#123"
                    android:textSize="25dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="18dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="190dp"
            android:layout_height="100dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#F59E0B"
            android:layout_marginLeft="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total workouts Time"
                    android:textSize="15sp"
                    android:textColor="#FCD5D9"
                    android:layout_marginTop="12dp"
                    android:layout_marginLeft="15dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvTime"
                    android:textColor="#123"
                    android:textStyle="bold"
                    android:textSize="25dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="18dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">
        <androidx.cardview.widget.CardView
            android:layout_width="190dp"
            android:layout_height="100dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#10B981"
            android:layout_marginLeft="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight"
                    android:textSize="15sp"
                    android:textColor="#FCD5D9"
                    android:layout_marginTop="12dp"
                    android:layout_marginLeft="15dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvWeight"
                    android:textStyle="bold"
                    android:textSize="25dp"
                    android:textColor="#123"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="18dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_width="190dp"
            android:layout_height="100dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#0EA5E9"
            android:layout_marginLeft="15dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="height"
                    android:textSize="15sp"
                    android:textColor="#FCD5D9"
                    android:layout_marginTop="12dp"
                    android:layout_marginLeft="15dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/tvHeight"
                    android:textStyle="bold"
                    android:textSize="25dp"
                    android:textColor="#123"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="18dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:layout_margin="20dp"
        android:padding="15dp"
        android:textColor="#FFFFFF"
        android:id="@+id/edit"
        android:backgroundTint="#067DF4"/>


</LinearLayout>
</ScrollView>