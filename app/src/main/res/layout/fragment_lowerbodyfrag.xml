<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#FFFFFF"
    tools:context=".lowerbodyfrag">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lower body workout"
            android:textSize="38sp"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="20dp"
            android:textColor="#070606"
            android:layout_marginLeft="10dp"/>
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:rowCount="3"
            android:columnCount="2">
            <androidx.cardview.widget.CardView
                android:layout_width="190dp"
                android:layout_height="255dp"
                app:cardBackgroundColor="#10B981"
                android:layout_marginBottom="20dp"
                android:layout_marginLeft="15dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_marginLeft="18dp"
                        android:layout_height="100dp"
                        android:src="@drawable/squats"
                        android:layout_marginTop="20dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Squats"
                        android:textColor="#070606"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="sets: 1 X 8"
                        android:textSize="14dp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="15dp"/>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/timer"
                        android:layout_marginTop="5dp"
                        />
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="completed"
                        android:id="@+id/btnsquts"
                        android:layout_marginTop="5dp"
                        android:backgroundTint="@color/blue"
                        android:layout_marginLeft="34dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="190dp"
                app:cardBackgroundColor="#FF6B6B"
                android:layout_height="255dp"
                android:layout_marginLeft="18dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_marginLeft="18dp"
                        android:layout_height="110dp"
                        android:src="@drawable/lunges"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Lunges"
                        android:textColor="#070606"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="sets: 1 X 6"
                        android:textSize="14dp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="15dp"/>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/timer"
                        />
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="completed"
                        android:layout_marginTop="5dp"
                        android:id="@+id/btnlunges"
                        android:backgroundTint="@color/blue"
                        android:layout_marginLeft="34dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="190dp"
                android:layout_height="255dp"
                app:cardBackgroundColor="#f4f08c"
                android:layout_marginBottom="20dp"
                android:layout_marginLeft="15dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_marginLeft="18dp"
                        android:layout_height="110dp"
                        android:src="@drawable/glute1"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Glute Bridge"
                        android:textColor="#070606"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="sets: 2 X 12"
                        android:textSize="14dp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="15dp"/>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/timer"
                        android:layout_marginTop="5dp"/>
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="completed"
                        android:layout_marginTop="5dp"
                        android:id="@+id/btngulte"
                        android:backgroundTint="@color/blue"
                        android:layout_marginLeft="34dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="190dp"
                android:layout_height="255dp"
                app:cardBackgroundColor="#F59E0B"
                android:layout_marginLeft="15dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_marginLeft="18dp"
                        android:layout_height="110dp"
                        android:src="@drawable/calf"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Calf Raises"
                        android:textColor="#070606"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="sets: 3 X 8"
                        android:textSize="14dp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="15dp"/>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/timer"
                        android:layout_marginTop="5dp"/>
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="completed"
                        android:layout_marginTop="5dp"
                        android:id="@+id/btncalf"
                        android:backgroundTint="@color/blue"
                        android:layout_marginLeft="34dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:layout_width="190dp"
                app:cardBackgroundColor="#0EA5E9"
                android:layout_height="255dp"
                android:layout_marginLeft="15dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="150dp"
                        android:layout_marginLeft="18dp"
                        android:layout_height="110dp"
                        android:src="@drawable/wallsit"
                        android:layout_marginTop="15dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Wall Sit"
                        android:textColor="#070606"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="sets: 2 X 20(sec hold)"
                        android:textSize="14dp"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="5dp"
                        android:layout_marginLeft="15dp"/>
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/timer"
                        android:layout_marginTop="5dp"/>
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="completed"
                        android:id="@+id/btnwall"
                        android:layout_marginTop="5dp"
                        android:backgroundTint="@color/blue"
                        android:layout_marginLeft="34dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>




        </GridLayout>
    </LinearLayout>



</ScrollView>